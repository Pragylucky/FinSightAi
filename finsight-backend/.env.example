# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/finsight
CLIENT_URL=http://localhost:3000

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Require the emailed 6-digit code before a new account can sign in. Off by default.
REQUIRE_EMAIL_VERIFICATION=false

# ── Email (verification codes + password reset) ─────────────────────────────
# Option A (recommended for production): Resend over HTTPS. Works on hosts that block SMTP.
#   Create a key at resend.com. EMAIL_FROM must be an address on a domain you verified there
#   (use "onboarding@resend.dev" only for testing; it can only email your own account address).
RESEND_API_KEY=
EMAIL_FROM=FinSight AI <onboarding@resend.dev>

# Option B: SMTP (e.g. Gmail with an App Password). Used only when RESEND_API_KEY is empty.
#   Many cloud hosts (Render free tier, etc.) block outbound SMTP, so prefer option A there.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# If neither is configured, the 6-digit code is printed in the server log instead (dev only).

# ── AI (chat + company analysis) ────────────────────────────────────────────
# Get a key at aistudio.google.com. Without it the AI chat and the AI analysis tab show "not configured".
GEMINI_API_KEY=
# Optional: override the model if Google renames/retires the default.
# GEMINI_MODEL=gemini-3.5-flash

# ── Market data ─────────────────────────────────────────────────────────────
# Prices, fundamentals, charts and news come from Yahoo Finance and need no key.
# Optional: extra global headlines on the News page.
FINNHUB_API_KEY=
